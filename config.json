{
    "GEMMCublasLt": {
        "datatype": "fp8e4m3"
    },
    
    "LLMBenchmark": {
        "models": {
            "meta-llama/Llama-3.1-8B":{
                "use_model": false,
                "type": "nvidia",
                "input_sizes": [128, 128, 128, 500, 1024, 2048],
                "output_sizes": [128, 1024, 2048, 2000, 1024, 2048],
                "tp_size": 1,
                "num_requests": 1000,
                "precision": "FP8"
            },

            "meta-llama/Llama-3.1-70B":{
                "use_model": true,
                "type": "nvidia",
                "input_sizes": [128, 128, 128, 500, 1024, 2048],
                "output_sizes": [128, 1024, 2048, 2000, 1024, 2048],
                "tp_size": 4,
                "num_requests": 1000,
                "precision": "FP8"
            },

            "meta-llama/Llama-3.1-405B":{
                "use_model": false,
                "type": "nvidia",
                "input_sizes": [128, 128, 128, 500, 1024, 2048],
                "output_sizes": [128, 1024, 2048, 2000, 1024, 2048],
                "tp_size": 4,
                "num_requests": 1000,
                "precision": "FP8"
            },

            "Meta-Llama-3.1-8B-Instruct-FP8-KV":{
                "use_model": true,
                "type": "amd",
                "max_num_seqs": [3000],
                "input_length":[128, 128, 128, 500, 1024, 2048],
                "output_length": [128, 1024, 2048, 2000, 1024, 2048],
                "tp_sizes": [1],
                "num_requests": [1000]
            },

            "Meta-Llama-3.1-70B-Instruct-FP8-KV":{
                "use_model": false,
                "type": "amd",
                "max_num_seqs": [3000],
                "input_length":[128, 128, 128, 500, 1024, 2048],
                "output_length": [128, 1024, 2048, 2000, 1024, 2048],
                "tp_sizes": [8],
                "num_requests": [1000]
            },

            "Meta-Llama-3.1-405B-Instruct-FP8-KV":{
                "use_model": false,
                "type": "amd",
                "max_num_seqs": [3000],
                "input_length":[128, 128, 128, 500, 1024, 2048],
                "output_length": [128, 1024, 2048, 2000, 1024, 2048],
                "tp_sizes": [8],
                "num_requests": [1000]
            }
        }
    },
    
    "LLAMA3Pretraining": {
        "mount_path": ".",
        "training_script": "Benchmarks/NVIDIA/LLAMA3Recipe.py",
        "docker_image": "nvcr.io/nvidia/nemo:25.04",
        "model": {
            "H200": {
                "3b": {
                    "micro_batch_size": 8,
                    "precision": "fp16",
                    "parallelism": {
                        "tp": 1,
                        "pp": 1,
                        "vp": null,
                        "cp": 2
                    }
                },
                "8b": {
                    "micro_batch_size": 2,
                    "precision": "bf16",
                    "parallelism": {
                        "tp": 1,
                        "pp": 1,
                        "vp": null,
                        "cp": 1
                    }
                }
            },
            "GB200": {
                "3b": {
                    "micro_batch_size": 4,
                    "precision": "fp16",
                    "parallelism": {
                        "tp": 1,
                        "pp": 1,
                        "vp": null,
                        "cp": 1
                    }
                },
                "8b": {
                    "micro_batch_size": 4,
                    "precision": "bf16",
                    "parallelism": {
                        "tp": 1,
                        "pp": 2,
                        "vp": null,
                        "cp": 1
                    }
                }
            }
        }
    }
}
